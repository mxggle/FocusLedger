{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "notification-windows",
  "description": "Permissions for the popup and fullscreen notification windows",
  "windows": ["popup", "fullscreen"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:allow-close",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-set-focus",
    "core:window:allow-start-dragging"
  ]
}
